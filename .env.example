PORT=5174
NODE_ENV=production
GOOGLE_CLIENT_ID=your_app_owned_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_app_owned_client_secret
# Packaged builds always auto-open the browser on launch; set this to force
# the same behavior when running from source (e.g. npm run start).
AUTO_OPEN_BROWSER=true

# Runs the catalog/email background workers in-process instead of forking
# child processes. Forked workers each open their own SQLite connection and
# contend with POS bill saves for the write lock. Packaged builds now default
# to 'true' automatically even if unset here; set explicitly to 'false' only
# if you need separate worker processes (e.g. multi-core scraping throughput).
SINGLE_PROCESS_WORKERS=true
